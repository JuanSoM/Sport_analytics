\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Caso de solapamiento múltiple en ByteTrack. La secuencia temporal muestra el estado previo al cruce, la fase de oclusión y la resolución final con intercambio de identidades. En particular, GT:4 pasa de estar asociado a T:11 a T:6, mientras que GT:16 pasa de T:6 a T:11, reflejando un \textit  {ID switch} inducido por el solapamiento.}}{41}{figure.caption.9}\protected@file@percent }
\newlabel{fig:bytetrack_solapamiento_multiple}{{4}{41}{Caso de solapamiento múltiple en ByteTrack. La secuencia temporal muestra el estado previo al cruce, la fase de oclusión y la resolución final con intercambio de identidades. En particular, GT:4 pasa de estar asociado a T:11 a T:6, mientras que GT:16 pasa de T:6 a T:11, reflejando un \textit {ID switch} inducido por el solapamiento}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Caso del ``jugador caído'' en ByteTrack. Las etiquetas \texttt  {GT} (verde) corresponden al \textit  {ground truth}, mientras que las etiquetas \texttt  {T} (rojo) corresponden a la salida del tracker. La secuencia ilustra cómo un cambio brusco de pose degrada la detección y provoca pérdida de consistencia en la identidad seguida.}}{42}{figure.caption.10}\protected@file@percent }
\newlabel{fig:bytetrack_jugador_caido}{{5}{42}{Caso del ``jugador caído'' en ByteTrack. Las etiquetas \texttt {GT} (verde) corresponden al \textit {ground truth}, mientras que las etiquetas \texttt {T} (rojo) corresponden a la salida del tracker. La secuencia ilustra cómo un cambio brusco de pose degrada la detección y provoca pérdida de consistencia en la identidad seguida}{figure.caption.10}{}}
