\@writefile{toc}{\contentsline {section}{\numberline {1}Diagnóstico del problema de identidad}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Análisis visual de fallos en ByteTrack}{2}{subsection.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Caso de solapamiento múltiple en ByteTrack. La secuencia temporal muestra el estado previo al cruce, la fase de oclusión y la resolución final con intercambio de identidades. En particular, GT:4 pasa de estar asociado a T:11 a T:6, mientras que GT:16 pasa de T:6 a T:11, reflejando un \textit  {ID switch} inducido por el solapamiento.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:bytetrack_solapamiento_multiple}{{1}{3}{Caso de solapamiento múltiple en ByteTrack. La secuencia temporal muestra el estado previo al cruce, la fase de oclusión y la resolución final con intercambio de identidades. En particular, GT:4 pasa de estar asociado a T:11 a T:6, mientras que GT:16 pasa de T:6 a T:11, reflejando un \textit {ID switch} inducido por el solapamiento}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Caso del ``jugador caído'' en ByteTrack. Las etiquetas \texttt  {GT} (verde) corresponden al \textit  {ground truth}, mientras que las etiquetas \texttt  {T} (rojo) corresponden a la salida del tracker. La secuencia ilustra cómo un cambio brusco de pose degrada la detección y provoca pérdida de consistencia en la identidad seguida.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:bytetrack_jugador_caido}{{2}{4}{Caso del ``jugador caído'' en ByteTrack. Las etiquetas \texttt {GT} (verde) corresponden al \textit {ground truth}, mientras que las etiquetas \texttt {T} (rojo) corresponden a la salida del tracker. La secuencia ilustra cómo un cambio brusco de pose degrada la detección y provoca pérdida de consistencia en la identidad seguida}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Casos críticos: oclusiones, jugador caído y teletransportación}{4}{subsection.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Caso de teletransportación y reciclaje de IDs en MOTIP. La secuencia temporal muestra cómo el mismo identificador se reutiliza sobre jugadores incompatibles, evidenciando una pérdida severa de coherencia espacial en el seguimiento.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:motip_teletransportacion}{{3}{5}{Caso de teletransportación y reciclaje de IDs en MOTIP. La secuencia temporal muestra cómo el mismo identificador se reutiliza sobre jugadores incompatibles, evidenciando una pérdida severa de coherencia espacial en el seguimiento}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Influencia del \texttt  {track\_buffer}}{5}{subsection.1.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Heurísticas tempranas y sus limitaciones}{6}{subsection.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Inicio de la creación de IDs fantasma en MOTIP. La secuencia muestra cómo una interacción entre jugadores deriva en la aparición progresiva de nuevas identidades no coherentes con la continuidad esperada de la escena.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:motip_ids_fantasma_inicio}{{4}{7}{Inicio de la creación de IDs fantasma en MOTIP. La secuencia muestra cómo una interacción entre jugadores deriva en la aparición progresiva de nuevas identidades no coherentes con la continuidad esperada de la escena}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Propagación del fenómeno de IDs fantasma en MOTIP. Tras el colapso inicial, el sistema continúa introduciendo nuevas identidades sobre la misma escena, lo que evidencia una pérdida severa de coherencia temporal y semántica.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:motip_ids_fantasma_propagacion}{{5}{7}{Propagación del fenómeno de IDs fantasma en MOTIP. Tras el colapso inicial, el sistema continúa introduciendo nuevas identidades sobre la misma escena, lo que evidencia una pérdida severa de coherencia temporal y semántica}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.5}Conclusión del diagnóstico}{7}{subsection.1.5}\protected@file@percent }
