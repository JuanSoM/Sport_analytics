\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Histogramas de distancias en el espacio de embeddings. La separación entre distribuciones es más clara en el caso de la identidad individual que en el caso del equipo.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:cap8_histogramas}{{3}{6}{Histogramas de distancias en el espacio de embeddings. La separación entre distribuciones es más clara en el caso de la identidad individual que en el caso del equipo}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Estructura del espacio de embeddings: t-SNE, PCA y similitud}{6}{subsection.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Proyecciones t-SNE del embedding. La estructura por equipo resulta más visible que la separación limpia por jugador individual.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cap8_tsne}{{4}{7}{Proyecciones t-SNE del embedding. La estructura por equipo resulta más visible que la separación limpia por jugador individual}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Proyecciones PCA del embedding. Aunque la reducción lineal no separa perfectamente a los jugadores, sí permite observar agrupaciones parciales relacionadas con la apariencia global de equipo.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cap8_pca}{{5}{7}{Proyecciones PCA del embedding. Aunque la reducción lineal no separa perfectamente a los jugadores, sí permite observar agrupaciones parciales relacionadas con la apariencia global de equipo}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Varianza explicada acumulada por PCA. Esta figura ayuda a valorar cuánta estructura útil del embedding se conserva en las primeras componentes principales.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cap8_pca_variance}{{6}{7}{Varianza explicada acumulada por PCA. Esta figura ayuda a valorar cuánta estructura útil del embedding se conserva en las primeras componentes principales}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Matriz de similitud coseno entre embeddings medios por identidad. Las similitudes elevadas entre distintos jugadores reflejan que el espacio de embeddings no está completamente separado a nivel individual.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cap8_similarity_matrix}{{7}{8}{Matriz de similitud coseno entre embeddings medios por identidad. Las similitudes elevadas entre distintos jugadores reflejan que el espacio de embeddings no está completamente separado a nivel individual}{figure.caption.10}{}}
